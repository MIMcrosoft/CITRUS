# Copier ce fichier vers .env et remplir les valeurs. Ne jamais versionner .env.
DJANGO_SECRET_KEY=
DEBUG=False
DJANGO_SSL_REDIRECT=1
API_KEY=
EMAIL_PSWD=
TEMP_PSWD=

# URL publique canonique, sans slash final (liens des courriels, QR codes, API)
SITE_URL=https://www.liguedespamplemousses.com

# Valeurs séparées par des virgules (sans espaces ni slash final)
ALLOWED_HOSTS=liguedespamplemousses.com,www.liguedespamplemousses.com
CSRF_TRUSTED_ORIGINS=https://liguedespamplemousses.com,https://www.liguedespamplemousses.com
CORS_ORIGIN_WHITELIST=https://liguedespamplemousses.com,https://www.liguedespamplemousses.com
